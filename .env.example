NODE_ENV=production
JWT_SECRET=change-this-to-a-random-secret
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this
POSTGRES_DB=dbname
API_URL=https://afroscholars.academy/api
FRONTEND_URL=https://afroscholars.academy
PORT=3333
# Caminho absoluto onde os uploads são guardados (padrão docker: /usr/src/app/uploads)
# UPLOAD_DIR=/root/api_afroscholars/uploads
# Ficheiros dos documentos à venda: nunca dentro da pasta de uploads, que é pública.
# Sem esta variável, fica ao lado da pasta de uploads, em documentos-privados.
# DOCUMENTOS_DIR=/root/api_afroscholars/documentos-privados

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30000
OPENAI_MAX_TOKENS=1024

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://afroscholars.academy/api/auth/google/callback

# Web Push (VAPID) — https://web-push-codelab.glitch.me/
VAPID_PUBLIC_KEY=BFNPdsaGGPaoeVfEDOCuOUnuZm2uJzwwkBztcsJdda31FTKd2QNyaYlrYhQkFRRTw6FXydes6NKe3oxJH4XVHok
VAPID_PRIVATE_KEY=VsGujun0euJTJYttHuM9TksoP57Q72I4Iqk_RZGFGag

# Jitsi JaaS (8x8) — https://jaas.8x8.vc
JITSI_APP_ID=
JITSI_KEY_ID=
JITSI_PRIVATE_KEY=

# MOMENU (Multicaixa Express e Referência)
# Webhook a configurar no painel da MoMenu: <API_URL>/webhooks/momenu
# O segredo tem de ser igual ao "Segredo do Webhook" do painel.
# Sem MOMENU_WEBHOOK_SECRET os webhooks são recusados.
MOMENU_API_KEY=
MOMENU_WEBHOOK_SECRET=
# Ambiente de testes, sem cobranças (ativar também no painel, em Desenvolvedores)
MOMENU_QA=false
