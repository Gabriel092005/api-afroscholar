NODE_ENV=dev
JWT_SECRET=
DATABASE_URL=
API_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173
PORT=3333
# OpenAI ou Groq (compatível)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30000
OPENAI_MAX_TOKENS=1024
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=
EMAIL_FROM=your-email@gmail.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Se não definido, será auto-derivado de API_URL + "/auth/google/callback"
# Em produção com proxy (/api): GOOGLE_CALLBACK_URL=https://seudominio.com/api/auth/google/callback
# Em produção sem proxy:     GOOGLE_CALLBACK_URL=https://seudominio.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3333/auth/google/callback
